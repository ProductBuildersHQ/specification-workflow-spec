{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ProductBuildersHQ/specification-workflow-spec/schema/rubricdef.schema.json",
  "$ref": "#/$defs/RubricDefinition",
  "$defs": {
    "Category": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Category identifier"
        },
        "name": {
          "type": "string",
          "description": "Category name"
        },
        "description": {
          "type": "string",
          "description": "Category purpose"
        },
        "weight": {
          "type": "number",
          "maximum": 1,
          "minimum": 0,
          "description": "Category weight"
        },
        "required": {
          "type": "boolean",
          "description": "Whether category is required to pass"
        },
        "scale": {
          "$ref": "#/$defs/Scale",
          "description": "Scoring scale"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name"
      ]
    },
    "PassCriteria": {
      "properties": {
        "minCategoriesPassing": {
          "type": "string",
          "description": "Minimum passing categories"
        },
        "maxFindingsSeverity": {
          "$ref": "#/$defs/SeverityLimits",
          "description": "Maximum findings by severity"
        },
        "minIntScore": {
          "type": "integer",
          "maximum": 5,
          "minimum": 1,
          "description": "Minimum integer score to pass"
        },
        "minNumericScore": {
          "type": "number",
          "maximum": 1,
          "minimum": 0,
          "description": "Minimum numeric score to pass"
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "RubricDefinition": {
      "properties": {
        "id": {
          "type": "string",
          "description": "Rubric identifier"
        },
        "name": {
          "type": "string",
          "description": "Rubric name"
        },
        "version": {
          "type": "string",
          "description": "Rubric version"
        },
        "description": {
          "type": "string",
          "description": "Rubric purpose"
        },
        "specType": {
          "type": "string",
          "description": "Spec type ID this rubric evaluates"
        },
        "evaluationType": {
          "type": "string",
          "enum": [
            "analytic",
            "holistic"
          ]
        },
        "categories": {
          "items": {
            "$ref": "#/$defs/Category"
          },
          "type": "array",
          "description": "Evaluation categories"
        },
        "passCriteria": {
          "$ref": "#/$defs/PassCriteria",
          "description": "Pass/fail criteria"
        },
        "methodology": {
          "type": "string",
          "description": "Source methodology"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "id",
        "name",
        "specType",
        "evaluationType",
        "categories"
      ]
    },
    "Scale": {
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "categorical",
            "integer",
            "numeric"
          ]
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ScaleOption"
          },
          "type": "array",
          "description": "Scale options"
        },
        "min": {
          "type": "number",
          "description": "Minimum value"
        },
        "max": {
          "type": "number",
          "description": "Maximum value"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "type"
      ]
    },
    "ScaleOption": {
      "properties": {
        "value": {
          "type": "string",
          "description": "Option value"
        },
        "label": {
          "type": "string",
          "description": "Option label"
        },
        "criteria": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Selection criteria"
        },
        "score": {
          "type": "number",
          "description": "Numeric score equivalent"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "value",
        "label"
      ]
    },
    "SeverityLimits": {
      "properties": {
        "critical": {
          "type": "integer",
          "description": "Max critical findings"
        },
        "high": {
          "type": "integer",
          "description": "Max high findings"
        },
        "medium": {
          "type": "integer",
          "description": "Max medium findings"
        },
        "low": {
          "type": "integer",
          "description": "Max low findings"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "title": "Rubric Definition",
  "description": "Schema for rubricdef definitions"
}